class Aluno {
  nome: string;
  nota: number;

  constructor(nome: string, nota: number) {
    this.nome = nome;
    this.nota = nota;
  }

  aprovado(): boolean {
    return this.nota >= 6;
  }
}

const aluno1 = new Aluno("André", 9);
const aluno2 = new Aluno("Miguel", 5);

console.log(aluno1.nome);
console.log(aluno1.nota);
console.log(aluno1.aprovado());

console.log(aluno2.nome);
console.log(aluno2.nota);
console.log(aluno2.aprovado());
